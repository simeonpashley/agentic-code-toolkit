{
  "name": "@simeonpashley/agentic-code-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "lint": "eslint scripts/",
    "typecheck": "npx tsc --noemit",
    "format:write": "prettier --write --no-color --log-level silent .",
    "install:global": "tsx scripts/install-global.ts",
    "token-hygiene:analyse": "tsx scripts/token-hygiene/analyse-metrics.ts",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:write && pnpm run test"
  },
  "pi": {
    "prompts": [
      "prompts/*.md"
    ],
    "skills": [
      "skills"
    ],
    "extensions": [
      "extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "^0.79.5",
    "@shikijs/cli": "^4.2.0",
    "@sinclair/typebox": "^0.34.49",
    "axe-core": "^4.12.1",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.3",
    "file-type": "^21.3.4",
    "playwright": "^1.61.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.5.0",
    "prettier": "^3.9.4",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
